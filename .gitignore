# Large data files — exclude raw downloads and intermediate outputs
data/raw/
data/processed/*.parquet
data/incidents/*.parquet
data/processed/*.joblib

# Keep dashboard-required scored outputs (small)
!data/processed/stage6_india_scores.parquet
!data/incidents/stage7_incident_scores.parquet
!data/processed/facilities.parquet

# Keep metadata and scripts
!data/**/*.json
!data/**/*.csv

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Env secrets
.env

# Playwright
.playwright-mcp/
dashboard/screenshot*.png
dashboard/static/mvtest.html

# Keep bundled runtime assets (needed to run the app offline)
!dashboard/static/bb-8.glb
!dashboard/static/model-viewer.min.js
!data/geo/*.json
!data/geo/*.geojson

# OS
.DS_Store
data/alerts.db

# NASA FIRMS API key — get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=905e60516dd1b352ed6fd1fb5dc2a2d5

# NASA Earthdata credentials — needed for ORNL DAAC (VNF) archive downloads
# Register free at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=teamzero1
EARTHDATA_PASSWORD=teamZeroOne123@

# Bounding box for India (lon_min, lat_min, lon_max, lat_max)
INDIA_BBOX=68.0,6.0,97.5,37.0

# How many days of NRT data to fetch (max 10 for VIIRS NRT without archive access)
FIRMS_NRT_DAYS=10

# Local data root (defaults to ./data if unset)
DATA_ROOT=./data
